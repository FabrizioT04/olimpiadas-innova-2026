# La CSP solo permite recursos del propio sitio (y data:/blob: para imágenes, usados por la vista previa
# de subidas). Si se añade un recurso externo (fuentes, analíticas, etc.), hay que incluir su dominio aquí.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; worker-src 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
